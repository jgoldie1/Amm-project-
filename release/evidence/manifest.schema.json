{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tryamm.online/schemas/release-evidence-manifest.json",
  "title": "TryAMM Release Evidence Manifest",
  "type": "object",
  "required": [
    "requirementId",
    "title",
    "owner",
    "sourceType",
    "date",
    "scope",
    "result",
    "reviewer",
    "artifacts"
  ],
  "properties": {
    "requirementId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "sourceType": {
      "enum": [
        "native-editor",
        "deployed-service",
        "licensed-asset",
        "performed-audio",
        "physical-device",
        "participant-study",
        "independent-security-review",
        "licensed-legal-review",
        "certification-authority",
        "internal-check"
      ]
    },
    "date": { "type": "string", "format": "date" },
    "expiresAt": { "type": ["string", "null"], "format": "date" },
    "scope": { "type": "string", "minLength": 1 },
    "result": { "enum": ["pass", "fail", "blocked", "expired", "incomplete"] },
    "reviewer": { "type": "string", "minLength": 1 },
    "independent": { "type": "boolean", "default": false },
    "confidentiality": { "enum": ["public", "sanitized", "private"] },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "reference"],
        "properties": {
          "name": { "type": "string" },
          "reference": { "type": "string" },
          "sha256": { "type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "notes": { "type": "string" },
    "remediation": { "type": "string" }
  },
  "additionalProperties": false
}
