NODE_ENV=development
PORT=10000
APP_URL=http://localhost:10000
ADMIN_EMAIL=theammonmiverse@gmail.com
PLATFORM_FEE_BPS=2500
DATA_FILE=./data/store.json

# Supabase server-side configuration. Never expose the service-role key in browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# HoloGPT conversational model provider. The server chooses the first configured provider:
# 1) OpenAI Responses API, 2) OpenAI-compatible endpoint, 3) Ollama, 4) Stubbs gateway.
# Never put provider keys in public/browser JavaScript.
OPENAI_API_KEY=
HOLOGPT_OPENAI_MODEL=gpt-5.4
# For OpenAI-compatible providers, set the full chat-completions endpoint URL.
HOLOGPT_API_URL=
HOLOGPT_API_KEY=
HOLOGPT_MODEL=
# Local/private model option.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
HOLOGPT_TIMEOUT_MS=20000

# Stubbs AI Tri-Brain runtime.
STUBBS_EXECUTIVE_URL=
STUBBS_SECOND_BRAIN_URL=
STUBBS_SANDBOX_URL=
STUBBS_MODEL_GATEWAY_TOKEN=
STUBBS_REQUEST_TIMEOUT_MS=15000

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Get Paid to Play remains Holo-Credits-only until the restricted cash reserve and payout controls are verified.
ENABLE_REAL_GAME_PAYOUTS=false
GAME_REWARD_DAILY_CASH_CAP_CENTS=2500

# Holo advertising allocation applies to VERIFIED NET ad revenue after provider fees/taxes.
# Defaults: 25% restricted player reward reserve, 50% operations, 15% growth, 10% contingency.
HOLO_AD_REWARD_RESERVE_BPS=2500
HOLO_AD_OPERATIONS_BPS=5000
HOLO_AD_GROWTH_BPS=1500
HOLO_AD_CONTINGENCY_BPS=1000

# Blockchain remains locked until an independent audit passes.
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_AUDIT_STATUS=NOT_SUBMITTED
BLOCKCHAIN_AUDIT_REPORT_SHA256=
BLOCKCHAIN_RELEASE_APPROVED_BY=

# Optional runtime markers
RENDER=
REPL_ID=
