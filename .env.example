NODE_ENV=development
PORT=10000
APP_URL=http://localhost:10000
ADMIN_EMAIL=theammonmiverse@gmail.com
PLATFORM_FEE_BPS=2500
DATA_FILE=./data/store.json

# Supabase server-side configuration. Never expose the service-role key in browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Blockchain remains locked until an independent audit passes.
# Do not set BLOCKCHAIN_ENABLED=true before all required audit evidence is approved.
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_AUDIT_STATUS=NOT_SUBMITTED
BLOCKCHAIN_AUDIT_REPORT_SHA256=
BLOCKCHAIN_RELEASE_APPROVED_BY=

# Optional runtime markers
RENDER=
REPL_ID=
