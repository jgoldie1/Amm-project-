NODE_ENV=development
PORT=10000
APP_URL=http://localhost:10000
ADMIN_EMAIL=theammonmiverse@gmail.com
PLATFORM_FEE_BPS=2500
DATA_FILE=./data/store.json

# Production commerce must use the transactional Postgres core.
# Development can remain false while migrations/provider credentials are being configured.
REQUIRE_TRANSACTIONAL_COMMERCE=false

# Supabase server-side configuration. Never expose the service-role key in browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Holographic Runtime WebRTC transport.
# STUN can use the default below for development. Production should configure TURN.
# Prefer short-lived TURN credentials issued by your TURN provider rather than permanent shared credentials.
HOLO_STUN_URL=stun:stun.l.google.com:19302
HOLO_TURN_URL=
HOLO_TURN_USERNAME=
HOLO_TURN_CREDENTIAL=

# Public/multi-user LIVE scaling boundary. Small rooms may use peer mesh; larger rooms
# must obtain short-lived participant credentials from a trusted SFU join service.
HOLO_SFU_PROVIDER=
HOLO_SFU_JOIN_URL=
HOLO_SFU_SERVICE_TOKEN=

# Stubbs AI Tri-Brain runtime.
# Executive and Second Brain must be independent provider/gateway endpoints that accept
# POST JSON and return: answer, confidence, evidenceIds, conclusionKey.
STUBBS_EXECUTIVE_URL=
STUBBS_SECOND_BRAIN_URL=
# Sandbox endpoint must return: passed/status, evidenceIds, checks, changedState, error.
STUBBS_SANDBOX_URL=
# Optional bearer token used only by the server when calling the private AI gateways.
STUBBS_MODEL_GATEWAY_TOKEN=
STUBBS_REQUEST_TIMEOUT_MS=15000

# Stripe marketplace/creator payments. Webhook secret is required in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# External provider adapters. URLs must be HTTPS. Credentials remain server-side.
# A configured adapter is NOT considered live until Command Center evidence records
# contract approval, live tests, and webhook verification where applicable.
IDENTITY_PROVIDER_URL=
IDENTITY_PROVIDER_TOKEN=
SUPPLIER_PROVIDER_URL=
SUPPLIER_PROVIDER_TOKEN=
WAREHOUSE_PROVIDER_URL=
WAREHOUSE_PROVIDER_TOKEN=
SHIPPING_PROVIDER_URL=
SHIPPING_PROVIDER_TOKEN=
TAX_PROVIDER_URL=
TAX_PROVIDER_TOKEN=
TELEPHONY_PROVIDER_URL=
TELEPHONY_PROVIDER_TOKEN=

# TRYAMM Mail transport
TRYAMM_MAIL_TRANSPORT_URL=
TRYAMM_MAIL_TRANSPORT_KEY=

# Optional live search providers
BRAVE_SEARCH_API_KEY=
KAGI_SEARCH_API_KEY=
CROSSREF_CONTACT_EMAIL=

# Blockchain remains locked until an independent audit passes.
# Do not set BLOCKCHAIN_ENABLED=true before all required audit evidence is approved.
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_AUDIT_STATUS=NOT_SUBMITTED
BLOCKCHAIN_AUDIT_REPORT_SHA256=
BLOCKCHAIN_RELEASE_APPROVED_BY=

# Optional runtime markers
RENDER=
REPL_ID=
