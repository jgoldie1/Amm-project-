# Supabase browser configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# AMM Express backend (Render/staging/production)
# Used by HoloGPT / Stubbs AI and server-controlled actions.
VITE_API_URL=https://your-amm-backend.example.com

# Without Supabase keys, the existing game can still run in demo/mock-login mode,
# but Living Worlds Passport, cloud projects, workforce runs, publishing and
# App Store entitlements will not persist.
