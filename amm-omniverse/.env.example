# ── Google OAuth via Supabase ──────────────────────────────────────
# 1. Create a free project at supabase.com
# 2. Go to Authentication > Providers > Google
# 3. Add your Google OAuth Client ID + Secret (from console.cloud.google.com)
# 4. Copy your Supabase URL and anon key below

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Without these, the game runs in DEMO MODE with mock Google login.
# Everything works — login, avatar, gameplay — just not persisted.
