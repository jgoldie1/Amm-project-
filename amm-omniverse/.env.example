# TRYAMM production browser configuration (public values only)
VITE_SUPABASE_URL=https://fxluchtdfpediivhoksl.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_y2OadDy1zy8QlWy-YAcdlg_uzAYMLzj
VITE_APP_URL=https://tryamm.online

# Optional external API origin.
# Leave VITE_API_URL EMPTY when Vercel should serve /api/* from the current origin.
# Set it only when intentionally routing to a separate backend.
VITE_API_URL=

# Release-protected TRYAMM Mobile UI. Keep false until the mobile franchise/MVNO slice passes its own review and provider gates.
VITE_TRYAMM_MOBILE_ENABLED=false

# All American University runtime. Enable only after its branch CI and production university migrations are verified.
VITE_ALL_AMERICAN_UNIVERSITY_ENABLED=false

# SERVER-ONLY production variables — configure in Vercel, never commit values.
SUPABASE_SERVICE_ROLE_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TRYAMM_CALL_CENTER_WEBHOOK_SECRET=
TRYAMM_INTERNAL_COMPLIANCE_SECRET=
TRYAMM_RETENTION_JOB_SECRET=
TRYAMM_RECORDING_ARCHIVE_SECRET=
TRYAMM_STT_ENDPOINT=
TRYAMM_STT_API_KEY=
TRYAMM_TTS_ENDPOINT=
TRYAMM_TTS_API_KEY=
OPENAI_API_KEY=

# Founder identity gate for issuing VIP/priority agency invites. Set this to the authenticated Supabase user UUID for the founder account in Vercel only.
TRYAMM_FOUNDER_USER_ID=

# TRYAMM Mobile server-only provider gates. Leave empty until an approved wholesale/MVNO/network partner supplies credentials.
TRYAMM_MOBILE_PROVIDER=
TRYAMM_MOBILE_API_BASE_URL=
TRYAMM_MOBILE_API_KEY=
TRYAMM_MOBILE_WEBHOOK_SECRET=
TRYAMM_MOBILE_NTN_PROVIDER=
TRYAMM_MOBILE_NTN_API_KEY=

# Controlled live-call verification. Keep both server-only.
TRYAMM_TEST_CALL_SECRET=
TRYAMM_TEST_CALL_DESTINATION=

# Optional live conversational voice bridge.
TRYAMM_MEDIA_STREAM_WSS_URL=
TRYAMM_CALL_CENTER_GREETING=Welcome to TRYAMM. Middleverse AI and a human agent can assist you.

# The publishable Supabase key above is browser-safe. Never put service-role,
# LiveKit API secret, Twilio Auth Token, AI provider secrets, carrier credentials,
# eSIM provisioning credentials, NTN partner secrets, founder identity values,
# or telecom webhook secrets in VITE_* values.
