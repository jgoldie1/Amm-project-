# LiveKit realtime audio/video
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Money Engine / payment-provider verification
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TRYAMM_INTERNAL_COMPLIANCE_SECRET=

# Recording/replay archive. Configure the bucket name for the storage provider actually used.
TRYAMM_RECORDING_ARCHIVE_SECRET=
TRYAMM_RECORDING_BUCKET=
# Alternative supported readiness names: S3_BUCKET, R2_BUCKET, SUPABASE_RECORDING_BUCKET

# AI provider
OPENAI_API_KEY=
# Alternatives: TRYAMM_AI_API_KEY or TRYAMM_AI_PROVIDER_KEY

# Telephony / AI call center (separate secondary release gate)
