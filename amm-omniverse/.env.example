# AMM Express backend (Render/staging/production)
# Used by LIVE, HoloGPT / Stubbs AI and server-controlled actions.
# Must be the real deployed HTTPS API URL before release GREEN.
VITE_API_URL=https://your-amm-backend.example.com

# SERVER-ONLY production variables — configure in Vercel/backend provider, never commit values.
