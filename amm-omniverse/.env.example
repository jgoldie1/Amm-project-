# Controlled live-call verification. Keep both server-only.
# Destination must be a number you own or are authorized to call.
TRYAMM_TEST_CALL_SECRET=
TRYAMM_TEST_CALL_DESTINATION=

# Optional live conversational voice bridge.
TRYAMM_MEDIA_STREAM_WSS_URL=
TRYAMM_CALL_CENTER_GREETING=Welcome to TRYAMM. Middleverse AI and a human agent can assist you.

# Without Supabase browser configuration, the existing game can still run in
# demo/mock-login mode, but Living Worlds Passport, cloud projects, workforce
# runs, publishing and App Store entitlements will not persist.
#
# The publishable Supabase key above is intentionally browser-safe. Never put
# service-role keys, provider secrets, webhook secrets, payment keys, LiveKit
# secrets, Twilio Auth Tokens, or AI provider secrets in any VITE_* variable.
