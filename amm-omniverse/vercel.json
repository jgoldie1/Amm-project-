{
  "installCommand": "npm install --include=dev --no-audit --no-fund",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "src": "/accessibility/?", "dest": "/accessibility.html" },
    { "src": "/accessibility.html", "dest": "/accessibility.html" },
    { "src": "/world-seasons/?", "dest": "/world-seasons.html" },
    { "src": "/all-american-university/?", "dest": "/all-american-university.html" },
    { "src": "/api/payments/status", "dest": "https://amm-project-1-rpz9.onrender.com/api/payments/status" },
    { "src": "/api/checkout", "methods": ["POST"], "dest": "https://amm-project-1-rpz9.onrender.com/api/checkout" },
    { "src": "/api/payments/verify-checkout", "methods": ["POST"], "dest": "https://amm-project-1-rpz9.onrender.com/api/payments/verify-checkout" },
    { "src": "/api/stripe/webhook", "methods": ["POST"], "dest": "https://amm-project-1-rpz9.onrender.com/api/stripe/webhook" },
    { "src": "/api/creator/earnings", "dest": "https://amm-project-1-rpz9.onrender.com/api/creator/earnings" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
