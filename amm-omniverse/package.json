{
  "name": "amm-omniverse",
  "version": "1.1.0",
  "type": "module",
  "engines": {"node": ">=24 <25"},
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings=0",
    "smoke": "node tests/smoke-contracts.mjs && node tests/living-world-recovery-contract.mjs && node tests/streetverse-economy-contract.mjs && node tests/streetverse-visible-loop-contract.mjs && node tests/asset-rights-contract.mjs && node tests/network-fast-xr-contract.mjs && node tests/aniyah-pay-contract.mjs && node tests/secs-construct-contract.mjs && node tests/mobility-blockchain-contract.mjs && node tests/omniverse-event-fabric-contract.mjs && node tests/performance-release-contract.mjs",
    "security": "node tests/repository-security-scan.mjs",
    "provider-gates": "node tests/provider-gates.mjs",
    "readiness": "node tests/production-readiness.mjs && npm run provider-gates",
    "build": "npm run smoke && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "check": "npm run lint && npm run security && npm run readiness && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@google/generative-ai": "^0.24.1",
    "@lottiefiles/dotlottie-io": "^0.0.4",
    "@lottiefiles/dotlottie-react": "^0.19.15",
    "@lottiefiles/dotlottie-web": "^0.79.2",
    "@supabase/supabase-js": "^2.108.2",
    "ai": "^7.0.79",
    "face-api.js": "^0.22.2",
    "howler": "^2.2.4",
    "livekit-client": "^2.20.0",
    "lottie-web": "^5.13.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "three": "^0.184.0",
    "three-stdlib": "^2.36.1",
    "tone": "^15.1.22",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test":"^1.55.0",
    "@types/react":"^18.3.0",
    "@types/react-dom":"^18.3.0",
    "@types/three":"^0.184.1",
    "@vitejs/plugin-react":"^5.0.4",
    "eslint":"10.9.1",
    "eslint-plugin-react-hooks":"7.1.1",
    "typescript":"^5.5.0",
    "typescript-eslint":"8.68.0",
    "vite":"7.3.6"
  },
  "overrides": {
    "minimatch@3":{"brace-expansion":"1.1.17"},
    "nanoid":"3.3.18",
    "node-fetch":"2.7.0",
    "postcss":"8.5.26",
    "tar":"7.5.22"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}