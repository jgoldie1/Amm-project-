# COPY this file to .env on YOUR SERVER; never commit .env.
# Configure a DNS A/AAAA record to this server BEFORE enabling HTTPS.
HOLO_AI_DOMAIN=ai.your-domain.example
CADDY_EMAIL=operator@your-domain.example
HOLOGPT_SELFHOST_MODEL=llama3.2:1b
# Generate on your server: openssl rand -hex 32
HOLO_LLAMA_PROXY_TOKEN=REPLACE_WITH_A_NEW_64_CHARACTER_HEX_SECRET
