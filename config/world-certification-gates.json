    "PRODUCTION_CERTIFIED": ["ci-green", "production-deployment-ready", "rollback-verified", "observability-ready", "security-review", "accessibility-check", "founder-evidence-record"]
  },
  "hardBlocks": {
    "unlicensedSource": true,
