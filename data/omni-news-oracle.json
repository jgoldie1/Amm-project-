        "requirements": [
          "regional source network",
          "producer approval",
          "live desk certification",
          "editorial standards review"
        ]
      },
      {
        "level": 4,
        "name": "Global OmniNews Anchor",
        "scope": "U.S., Africa/Nigeria, BRICS and international programs, breaking-news desk, major interviews and specials",
        "requirements": [
          "global editorial approval",
          "legal and standards training",
          "crisis/breaking-news certification",
          "auditable corrections history",
          "regional source literacy"
        ]
      }
    ]
