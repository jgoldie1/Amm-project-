  "preferred_ingestion_order": [
    "official API / public open data",
    "licensed commercial feed",
    "RSS / Atom",
    "contracted partner push",
    "approved publisher metadata feed",
    "community submission with review",
    "HTML scraping only when site terms and rights explicitly permit it"
  ],
  "rules": [
    "No source is enabled until license, attribution, redistribution, retention and rate-limit terms are recorded.",
    "Do not bypass paywalls, robots controls, authentication, CAPTCHAs or technical access controls.",
    "Do not scrape full copyrighted articles unless a contract, license or site terms explicitly permit it.",
    "Prefer metadata, excerpts and links when full-content rights are absent.",
    "Community submissions remain unverified until editorial review and source corroboration.",
    "Weather, finance, sports, mobility and public-safety values must retain provider timestamps and source attribution.",
    "AI may summarize, translate, cluster and rank but cannot upgrade an unverified item to verified without an authorized review step.",
    "Public-safety partner feeds require contractual access, server-side authentication, purpose limitation and retention controls.",
    "No private-person tracking, private plate publication, doxxing, camera-avoidance routing or live tactical tracking."
  ],
  "public_safety_provider_policy": {
    "shotspotter_soundthinking": {
      "status": "provider_gated_not_connected",
      "ingestion_mode": "official partner push/API only",
      "requirements": [
        "licensed agency or partner access",
        "official vendor integration documentation",
        "server-side authentication",
        "explicit permitted uses",
        "retention and deletion policy",
        "source and timestamp labeling"
      ],
      "prohibited": [
        "scraping vendor dashboards",
        "claiming live coverage without authorization",
        "tracking private individuals",
        "camera or police avoidance routing"
      ]
    }
  },
  "pipeline": [
    "source_registration",
    "license_policy_check",
    "ingest",
    "normalize",
    "deduplicate_cluster",
    "geography_lane_tagging",
    "product_purpose_tagging",
    "source_reliability_scoring",
    "freshness_scoring",
    "fact_and_media_checks",
    "editorial_or_system_queue",
    "streetverse_sparrow_routing",
    "human_or_authorized_review",
    "publish_web_free_tv_fast_social_holo_map_missions"
  ],
