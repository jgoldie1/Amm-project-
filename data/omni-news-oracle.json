  "retention_policy": {
    "raw_payload": "Keep only for the shortest practical normalization/audit window, then delete or irreversibly de-identify unless a legal or contractual requirement applies.",
    "normalized_signal": "Retain only product, audit, safety and compliance fields that remain necessary.",
    "precise_location": "Reduce to neighborhood or city precision unless precise coordinates are contractually permitted and necessary for the product purpose."
  },
