{
  "name": "TryAMM Free TV Production & Distribution OS",
  "version": "0.1.0",
  "purpose": "Creator-first operating model for rights-safe ingestion, review, packaging, monetization, scheduling, distribution, and analytics for original and licensed audiovisual programming.",
  "principles": [
    "Original platform identity; do not copy third-party branding or protected show formats",
    "No title publishes until required rights and compliance gates pass",
    "Creators receive a guided checklist instead of having to understand every production requirement unaided",
    "Standard video works first; immersive Holo5DX outputs are optional enhancements",
    "Age-appropriate lanes and territory restrictions are enforced before playback"
  ],
  "creator_workflow": [
    "create_title",
    "select_movie_series_reality_live_or_fast",
    "upload_master_trailer_poster_captions_and_metadata",
    "declare_ownership_and_distribution_rights",
    "attach_participant_music_footage_and_location_clearances",
    "complete_age_rating_and_content_disclosures",
    "technical_qc",
    "rights_compliance_review",
    "transcode_and_package",
    "configure_territories_windows_and_monetization",
    "schedule_or_publish",
    "measure_viewership_revenue_and_retention"
  ],
  "rights_gates": {
    "required_as_applicable": [
      "participant releases",
      "music synchronization/master-use or other appropriate music rights",
      "third-party footage/still/artwork permissions",
      "location/property releases",
      "distribution territory/window rights",
      "trademark/publicity/privacy review",
      "minor/guardian documentation when legally permitted and applicable",
      "qualified legal review for higher-risk productions"
    ],
    "states": ["missing", "submitted", "under_review", "approved", "rejected", "expired"]
  },
  "catalog": {
    "types": ["movie", "series", "episode", "reality", "documentary", "music_video", "creator_original", "live_event", "fast_channel"],
    "lanes": ["kids_family", "teen", "general", "mature_18_plus"],
    "features": ["search", "watchlist", "continue_watching", "captions", "multi_language_metadata", "recommendations", "profiles", "parental_controls"]
  },
  "fast": {
    "channels": ["TryAMM Reality", "TryAMM Movies", "TryAMM Music TV", "TryAMM Creator TV", "TryAMM Africa", "TryAMM Caribbean", "TryAMM Faith & Education"],
    "needs": ["program schedule", "electronic program guide", "playout service", "ad markers", "channel health monitoring", "territory rules"]
  },
  "monetization": {
    "models": ["AVOD", "FAST", "optional_subscription", "PPV", "sponsorship", "creator_subscriptions", "commerce", "live_gifts_where_allowed"],
    "ledger_requirement": "All ad, subscription, PPV, creator/licensor share, refund, fee and payout events must post to an auditable ledger before production payouts are enabled.",
    "ad_safety": ["frequency caps", "category exclusions", "age suitability", "territory eligibility", "brand safety", "fraud detection"]
  },
  "creator_revenue": {
    "policy": "Revenue-share percentages are configurable by signed distribution agreement and must not be hard-coded as ownership rights.",
    "statements": ["gross eligible revenue", "platform/ad-tech fees", "contractual deductions", "net distributable revenue", "creator/licensor share", "payout status"]
  },
  "technical_pipeline": [
    "upload_or_cloud_ingest",
    "malware_scan",
    "media_probe",
    "technical_qc",
    "transcode_ladder",
    "caption_subtitle_packaging",
    "thumbnail_poster_derivatives",
    "DRM_or_signed_delivery_when_required",
    "CDN_origin",
    "playback_entitlement",
    "ad_decisioning",
    "QoE_analytics"
  ],
  "reality_network_integration": {
    "production_compliance_os": true,
    "features": ["casting", "release tracking", "incident/safety workflow", "episode workspace", "AI-assisted transcription/logging", "human editorial approval", "reunions", "aftershows", "cast creator profiles", "merchandise and music links"]
  },
  "holo5dx": {
    "standard_playback_required": true,
    "optional_extensions": ["virtual theater", "spatial aftershow", "interactive set", "Holo5DX-compatible event"],
    "hardware_note": "Actual holographic/light-field output requires compatible calibrated optical/display hardware."
  },
  "minimum_production_backend": [
    "Passport authentication and RBAC",
    "durable catalog database",
    "object/media storage",
    "upload jobs and resumability",
    "rights/compliance document store",
    "moderation/review queues",
    "transcoding provider or workers",
    "CDN",
    "playback entitlement service",
    "watch history and profiles",
    "ad/monetization integration",
    "OmniPay/Stripe ledger where applicable",
    "analytics/privacy controls",
    "admin audit logs"
  ],
  "release_gate": {
    "publish_only_if": ["technical_qc_passed", "required_rights_approved", "content_lane_assigned", "territory_window_valid", "playback_package_ready", "moderation_review_passed_if_required"],
    "never_claim_complete_until": "A real uploaded title can pass the entire workflow and play reliably on supported devices with rights, analytics and monetization records verified."
  }
}
