    },
    {
      "id": "adapted-cards",
      "name": "Adapted Card Room",
      "modes": ["spades", "bid whist", "dominoes", "go fish", "solitaire", "rummy"],
      "features": ["one-handed controls", "voice play", "large suits and numbers", "turn reminders", "slow mode", "partner assist rules"]
    },
    {
      "id": "chair-trivia",
      "name": "Chair Trivia & Team Challenge",
      "features": ["individual or team play", "history", "music", "sports", "faith", "local culture", "accessible buzzer", "voice and switch input"]
    },
    {
      "id": "gentle-motion",
      "name": "Gentle Motion Games",
      "features": ["optional seated movement prompts", "range-of-motion friendly", "no scoring pressure", "skip any activity", "caregiver-led mode"],
      "safety_note": "Activities must include clear limits and should not replace professional rehabilitation guidance."
    }
