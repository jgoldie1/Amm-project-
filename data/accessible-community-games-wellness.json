  "social_programs": [
    "morning coffee room",
    "family game night",
    "senior-center league",
    "stroke survivor social room",
    "caregiver support room",
    "music and memories hour",
    "community testimony hour",
    "birthday and celebration room",
    "neighborhood news discussion",
    "accessible worship and faith programs",
    "virtual field trips",
    "intergenerational mentorship rooms"
  ],
  "accessibility_defaults": {
    "visual": ["large-text preset", "high contrast", "screen-reader labels", "color-independent states", "reduced animation", "zoom-safe layout"],
    "motor": ["large tap targets", "single-switch scanning support target", "one-handed navigation", "dwell/voice selection target", "adjustable response time", "no drag-only actions"],
    "hearing": ["live captions target", "transcripts", "visual alerts", "sign-language window support target", "volume-independent cues"],
    "speech": ["text chat", "preset phrases", "symbol-assisted communication target", "speech-to-text target"],
    "cognitive": ["simple mode", "one-task-per-screen", "repeat instructions", "practice round", "no countdown by default", "clear exit and help buttons"],
    "language": ["plain-language mode", "multilingual captions target", "translated instructions target"]
