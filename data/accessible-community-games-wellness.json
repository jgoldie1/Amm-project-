{
  "name": "TryAMM Accessible Community Games & Wellness",
  "version": "0.1.0",
  "purpose": "Inclusive social games, community programming, accessible entertainment and wellness engagement for older adults and disabled users.",
  "principles": [
    "Accessibility is the default experience, not a separate mode",
    "No cash wagering or cash-out in the senior and disability lane",
    "Large targets, simple navigation, voice support and low-cognitive-load flows",
    "Human connection and dignity come before engagement metrics",
    "Caregiver and support-person participation requires clear consent and role limits",
    "Health and wellness features are informational and social, not medical diagnosis or emergency care"
  ],
  "audiences": [
    "older adults",
    "people with mobility impairments",
    "stroke survivors",
    "people with low vision or blindness",
    "deaf and hard-of-hearing users",
    "people with speech impairments",
    "people with cognitive or learning disabilities",
    "caregivers and family members",
    "senior centers, rehabilitation programs and community organizations"
  ],
  "games": [
    {
      "id": "community-bingo",
      "name": "Community Bingo",
      "modes": ["solo practice", "family room", "senior-center room", "hosted live game", "team bingo", "audio bingo", "picture bingo", "music bingo", "scripture/faith bingo", "neighborhood bingo"],
      "features": ["automatic number marking optional", "slow-call mode", "repeat last number", "large-print cards", "voice-called numbers", "captioned calls", "color-independent marking", "caregiver assist with consent", "no cash wagering"]
    },
    {
      "id": "memory-match",
      "name": "Memory Match",
      "features": ["adjustable board size", "photo, word or sound pairs", "untimed mode", "gentle hints", "family photo packs", "local-history packs"]
    },
    {
      "id": "word-circle",
      "name": "Word Circle",
      "features": ["word search", "crossword-lite", "finish the phrase", "spelling assistance", "voice input", "large type"]
    },
    {
      "id": "music-memories",
      "name": "Music Memories",
