{
  "version":"0.1.0",
  "name":"TryAMM Creator Production Compliance OS",
  "purpose":"Guide creators and local production partners from show setup through legal/safety readiness, filming, review, and distribution without treating TryAMM as substitute legal counsel.",
  "workflow":["project-setup","jurisdiction-intake","cast-and-crew","rights-and-releases","locations-and-permits","insurance-and-risk","age-and-consent","workplace-safety","moderation-and-incidents","legal-review","greenlight","production","post-production-rights-check","distribution-clearance"],
  "gates":{
    "project-setup":["show title","producer entity","production type","shoot dates","jurisdictions","age rating"],
    "cast-and-crew":["identity status","age status","role","contact","contract/release status","emergency contact where appropriate"],
    "rights-and-releases":["participant release","appearance release","music rights","footage/archive rights","third-party marks/property","location release"],
    "locations-and-permits":["location owner approval","permit determination","public-space requirements","drone/special equipment review","local authority requirements"],
    "insurance-and-risk":["production insurance determination","general liability","workers compensation where required","equipment/auto coverage where applicable","special activity riders"],
    "age-and-consent":["18+ verification for adult productions","minor guardian workflow where allowed","scene-level consent","revocation/escalation process","privacy preferences"],
    "workplace-safety":["code of conduct","anti-harassment policy","violence/threat response","medical/emergency plan","transportation safety","intimacy/stunt/specialist coordinator determination"],
    "moderation-and-incidents":["report intake","evidence retention","triage severity","protective measures","investigation owner","appeal/escalation","closure record"],
    "legal-review":["jurisdiction-specific counsel review","contract/release review","rights clearance","permit/insurance confirmation","distribution clearance"],
    "greenlight":["all mandatory gates complete","open critical incidents resolved or accepted by authorized reviewer","legal/safety signoff recorded"]
  },
  "creatorExperience":{
    "mode":"guided-wizard",
    "features":["plain-language questions","auto-generated checklist","template library","upload center","expiration reminders","missing-item alerts","jurisdiction flags","partner assignment","legal/safety review queue","greenlight dashboard"]
  },
  "localProductionPartner":{
    "responsibilities":["casting logistics","local filming operations","labor compliance","permits","location coordination","insurance coordination","releases execution","local safety implementation","incident first response"],
    "tryammResponsibilities":["workflow software","document collection","status tracking","distribution technology","creator/cast profiles","streaming/live tools","payments/ledger integration where enabled","analytics","moderation tooling","audit trail"]
  },
  "disclaimer":"Templates and workflows are operational aids only. Jurisdiction-specific legal, labor, insurance, tax, privacy, licensing, and permitting requirements require qualified professionals and appropriate authorities."
}
